<configs>

<conditional>
	<!-- Check to make sure Simple UI is not installed first to avoid conflicts -->
	<if cond="mod_loaded('RW_SimpleUI') == 'false'">

		<!-- Adjust player dropped backpack size to avoid errors when picking up bag after death -->
		<!-- Loot window will extend off bottom of screen but no items will be lost and can still loot all/sort-->
		<set xpath="/lootcontainers/lootcontainer[@name='playerBackpack']/@size">9,35</set>

		<!--Fix for using vanilla scrollview/scrollbar in game v3.0 and above-->
		<!-- Adjust dropped bag sizes to avoid issues -->
		<conditional>
			<if cond="game_version() &gt;= version(1,3,0)">
				<set xpath="/lootcontainers/lootcontainer[@name='cntDropBag']/@size">9,35</set>
				<set xpath="/lootcontainers/lootcontainer[starts-with(@name, 'zPack')]/@size">9,35</set>
			</if>
		</conditional>

	</if>
</conditional>

</configs>