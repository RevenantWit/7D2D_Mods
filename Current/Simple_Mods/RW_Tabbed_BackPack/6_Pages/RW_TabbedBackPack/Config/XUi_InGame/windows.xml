<configs>

<!--Remove backpack icon from top left of backpack grid header to make room for tabs-->
<remove xpath="/windows/window[@name='windowBackpack']/rect/sprite[@name='windowIcon' and @sprite='ui_game_symbol_backpack']"/>

<!--Remove "Inventory" text from top left of backpack grid header to make room for tabs-->
<remove xpath="/windows/window[@name='windowBackpack']/rect/label[@name='windowName' and @text_key='xuiInventory']"/>

<!--Remove the backpack grid from the vanilla backpack window-->
<remove xpath="/windows/window[@name='windowBackpack']/rect[@name='content' and ./grid[@name='inventory']]"/>

<!--Append the new tabbed backpack grid to the backpack window-->
<append xpath="/windows/window[@name='windowBackpack']">

	<rect name="tabs" controller="TabSelector" pos="0,0" size="606, 349">
		<rect name="tabsHeader" height="43" pos="0,0" depth="1">

			<grid name="tabButtons" depth="2" rows="1" cols="6" pos="3,-3" cell_width="35" cell_height="36" repeat_content="true">
				<rect controller="TabSelectorButton" >
					<simplebutton name="tabButton" width="35" height="36" depth="3" font_size="24" defaultcolor="64,64,64" selectedsprite="map_poi_editor" selectedcolor="[beige]" caption="{tab_name_localized}"/>
				</rect>
			</grid>
		</rect>

		<rect name="tabsContents" controller="Backpack">
			<rect name="content" height="303" depth="0" pos="0,-46">
				<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" width="606" height="336" color="[black]" type="sliced" fillcenter="false" on_press="true" snap="false" gamepad_selectable="false"/>

				<rect controller="TabSelectorTab" tab_key="1">
					<grid depth="10" name="inventory" rows="5" cols="9" pos="3,-3" cell_width="67" cell_height="67" repeat_content="true" >
						<item_stack on_scroll="true" name="0" cell_size="67"/>
					</grid>
				</rect>

				<rect controller="TabSelectorTab" tab_key="2" pos="0,0">
					<grid depth="10" name="inventory" rows="5" cols="9" pos="3,-3" cell_width="67" cell_height="67" repeat_content="true" >
						<item_stack on_scroll="true" name="0" cell_size="67"/>
					</grid>
				</rect>

				<rect controller="TabSelectorTab" tab_key="3" pos="0,0">
					<grid depth="10" name="inventory" rows="5" cols="9" pos="3,-3" cell_width="67" cell_height="67" repeat_content="true" >
						<item_stack on_scroll="true" name="0" cell_size="67"/>
					</grid>
				</rect>

				<rect controller="TabSelectorTab" tab_key="4" pos="0,0">
					<grid depth="10" name="inventory" rows="5" cols="9" pos="3,-3" cell_width="67" cell_height="67" repeat_content="true" >
						<item_stack on_scroll="true" name="0" cell_size="67"/>
					</grid>
				</rect>

				<rect controller="TabSelectorTab" tab_key="5" pos="0,0">
					<grid depth="10" name="inventory" rows="5" cols="9" pos="3,-3" cell_width="67" cell_height="67" repeat_content="true" >
						<item_stack on_scroll="true" name="0" cell_size="67"/>
					</grid>
				</rect>

				<rect controller="TabSelectorTab" tab_key="6" pos="0,0">
					<grid depth="10" name="inventory" rows="5" cols="9" pos="3,-3" cell_width="67" cell_height="67" repeat_content="true" >
						<item_stack on_scroll="true" name="0" cell_size="67"/>
					</grid>
				</rect>
			</rect>
		</rect>
	</rect>

</append>

<!-- Adjust dropped bag size and make it scrollable -->

<remove xpath="//window[@name='windowBagStorage']/grid[@name='queue']"/>

<set xpath="//window[@name='windowBagStorage']/@height">740</set>

<append xpath="//window[@name='windowBagStorage']">

	<rect name="scrollarea" depth="2" pos="3,-43" >
		<scrollbar pos="${parentinnerwidth-17},-3" width="16" depth="2">
			<sprite name="thumb" depth="0" pos="2,0" width="12" height="${parentinnerheight}" sprite="menu_empty" type="sliced" color="[rwsui_scrollbar_color]" fillcenter="true" on_press="true" on_scroll="true" gamepad_selectable="false" snap="false" />
			<sprite name="background" depth="0" height="${parentinnerheight}" sprite="menu_empty2px" type="sliced" color="[darkGrey]" fillcenter="false" on_press="true" on_scroll="true" gamepad_selectable="false" snap="false" />
		</scrollbar>

		<scrollview name="scrollview" depth="1" width="{windowWidth}" height="{windowHeight}" >
			<grid depth="2" name="queue" rows="40" cols="10" cell_width="67" cell_height="67" repeat_content="true">
				<item_stack cell_size="67" name="0" />
			</grid>
		</scrollview>
	</rect>
</append>

<!--Patch to make backpack tab buttons thinner when using Beyond Storage 3-->
<conditional>
	<if cond="mod_loaded('BeyondStorage3')">
		<set xpath="//window[@name='windowBackpack']//rect/grid[@name='tabButtons' and @cell_width='35']/@cell_width">23</set>
		<set xpath="//window[@name='windowBackpack']//rect/grid[@name='tabButtons']/rect/simplebutton[@name='tabButton' and @width='35']/@width">23</set>
	</if>
</conditional>

</configs>
