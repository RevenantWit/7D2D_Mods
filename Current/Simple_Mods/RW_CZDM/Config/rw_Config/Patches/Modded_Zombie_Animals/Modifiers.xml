<config>

<!--_MODDED_ZOMBIE_ANIMALS START-->
<append xpath="//entity_class[@name='playerMale']">
	<!--Body Damage-->
	<effect_group name="rwBodyDamageModifier">
		<requirement name="IsAlive" target="other"/>
		<requirement name="!HitLocation" body_parts="Head"/>
		<requirement name="EntityTagCompare" target="other" tags="rwZombieAnimalsMod"/>
		<passive_effect name="DamageModifier" operation="perc_add" value="-0.80"/><!--Body Damage Multiplier-->
	</effect_group>
	<!--Head Damage-->
	<effect_group name="rwHeadDamageModifier">
		<requirement name="IsAlive" target="other"/>
		<requirement name="HitLocation" body_parts="Head"/>
		<requirement name="EntityTagCompare" target="other" tags="rwZombieAnimalsMod"/>
		<passive_effect name="DamageModifier" operation="perc_add" value="0.00"/><!--Head Damage Multiplier-->
	</effect_group>
</append>
<!--_MODDED_ZOMBIE_ANIMALS END-->

</config>
