	<!--_DOG START-->
		<!--Body Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'ZombieAnimal.ZombieDog.BodyDamage') != '-0.80'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwBodyDamageModifier' and ./requirement[@tags='rwZombieDogs']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'ZombieAnimal.ZombieDog.BodyDamage')</set>
			</if>
		</conditional>
		<!--Head Damage Multiplier-->
