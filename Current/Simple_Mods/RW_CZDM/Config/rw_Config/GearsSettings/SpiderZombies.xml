<config>
<!--CONTENTS START-->
<!---->
<!--_SPIDER_ZOMBIES-->
<!---->
<!--_NORMAL-->
<!--_FERAL-->
<!--_RADIATED-->
<!--_CHARGED-->
<!--_INFERNAL-->
<!---->
<!--CONTENTS END-->

<!--_SPIDER_ZOMBIES START-->
	<!--_NORMAL START-->
		<!--Body Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Regular.BodyDamage') != '-0.90'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwBodyDamageModifier' and ./requirement[@tags='rwSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Regular.BodyDamage')</set>
			</if>
		</conditional>
		<!--Head Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Regular.HeadDamage') != '0.00'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwHeadDamageModifier' and ./requirement[@tags='rwSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Regular.HeadDamage')</set>
			</if>
		</conditional>
	<!--_NORMAL END-->

	<!--_FERAL START-->
		<!--Body Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Feral.BodyDamage') != '-0.90'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwBodyDamageModifier' and ./requirement[@tags='rwFeralSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Feral.BodyDamage')</set>
			</if>
		</conditional>
		<!--Head Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Feral.HeadDamage') != '0.00'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwHeadDamageModifier' and ./requirement[@tags='rwFeralSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Feral.HeadDamage')</set>
			</if>
		</conditional>
	<!--_FERAL END-->

	<!--_RADIATED START-->
		<!--Body Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Radiated.BodyDamage') != '-0.90'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwBodyDamageModifier' and ./requirement[@tags='rwRadSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Radiated.BodyDamage')</set>
			</if>
		</conditional>
		<!--Head Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Radiated.HeadDamage') != '0.00'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwHeadDamageModifier' and ./requirement[@tags='rwRadSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Radiated.HeadDamage')</set>
			</if>
		</conditional>
	<!--_RADIATED END-->

<!--The following groups only apply if running game version 2.0 or higher-->
<conditional>
	<if cond="game_version() &gt;= version(1,2,0)">
	<!--_CHARGED START-->
		<!--Body Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Charged.BodyDamage') != '-0.90'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwBodyDamageModifier' and ./requirement[@tags='rwChargedSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Charged.BodyDamage')</set>
			</if>
		</conditional>
		<!--Head Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Charged.HeadDamage') != '0.00'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwHeadDamageModifier' and ./requirement[@tags='rwChargedSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Charged.HeadDamage')</set>
			</if>
		</conditional>
	<!--_CHARGED END-->

	<!--_INFERNAL START-->
		<!--Body Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Infernal.BodyDamage') != '-0.90'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwBodyDamageModifier' and ./requirement[@tags='rwInfernalSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Infernal.BodyDamage')</set>
			</if>
		</conditional>
		<!--Head Damage Multiplier-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'SpiderZombie.Infernal.HeadDamage') != '0.00'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwHeadDamageModifier' and ./requirement[@tags='rwInfernalSpiderZombies']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'SpiderZombie.Infernal.HeadDamage')</set>
			</if>
		</conditional>
	<!--_INFERNAL END-->
	</if>
</conditional>
<!--_SPIDER_ZOMBIES END-->

</config>