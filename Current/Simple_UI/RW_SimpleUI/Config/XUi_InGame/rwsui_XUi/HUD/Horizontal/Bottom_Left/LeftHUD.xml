			<!--Stealth Bar-->
			<rwsui_simple_statbar_stealth style="rwsui_stealthbar" pos="0,49" />

			<!--Stamina Bar-->
			<rwsui_simple_statbar style="rwsui_staminabar" />

			<!--Health Bar-->
			<rwsui_simple_statbar style="rwsui_healthbar" pos="0,-49" />

			<!--Food Bar-->
			<rwsui_simple_statbar style="rwsui_foodbar, rwsui_half_horizontal_statbar" pos="0,-98" />

			<!--Water Bar-->
			<rwsui_simple_statbar style="rwsui_waterbar, rwsui_half_horizontal_statbar" pos="86,-98" />
		</rect>
	</window>

</append>

</configs>
