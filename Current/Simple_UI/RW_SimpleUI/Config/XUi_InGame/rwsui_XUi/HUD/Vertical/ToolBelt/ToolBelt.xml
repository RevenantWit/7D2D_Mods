		<rwsui_simple_statbar style="rwsui_waterbar, rwsui_toolbelt_vertical_statbar" pos="953,0" text="[rwsui_statcurrent_foodwater_text]" />

	</window>

	<window name="RWSUI_ToolBelt15" anchor="CenterBottom" pos="-563,97" cursor_area="true">
		<rect name="windowToolbelt" width="1128" height="78" depth="5" backgroundcolor="[black]" controller="ToolbeltWindow">

			<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" on_press="true" snap="false" gamepad_selectable="false" />
			
