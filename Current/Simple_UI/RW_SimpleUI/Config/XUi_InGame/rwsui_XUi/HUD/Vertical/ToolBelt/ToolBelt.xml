<configs>

<append xpath="/windows">

	<window name="RWSUI_ToolBelt10" anchor="CenterBottom" pos="-376,97" cursor_area="true">
		<rect name="windowToolbelt" width="753" height="78" depth="5" backgroundcolor="[black]" controller="ToolbeltWindow">

			<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" on_press="true" snap="false" gamepad_selectable="false" />
			
			<!--Simple Toolbelt-->
			<rwsui_toolbelt clear_inventory1_pos="765,19" clear_inventory2_pos="765,53" />

			<!--Stealth Bar-->
			<rwsui_custom_statbar_stealthx2_fillOnly style="rwsui_stealthbar" />

		</rect>

		<!--XP Bar-->
		<rwsui_simple_statbar_xp style="rwsui_xpbar, rwsui_toolbelt_xpbar" />

		<!--Stamina Bar-->
		<rwsui_simple_statbar style="rwsui_staminabar, rwsui_toolbelt_vertical_statbar" pos="-100,0" text="[rwsui_statcurrent_stamina_text]" />

		<!--Health Bar-->
		<rwsui_simple_statbar style="rwsui_healthbar, rwsui_toolbelt_vertical_statbar" pos="-50,0" />

		<!--Food Bar-->
		<rwsui_simple_statbar style="rwsui_foodbar, rwsui_toolbelt_vertical_statbar" pos="753,0" text="[rwsui_statcurrent_foodwater_text]" />

		<!--Water Bar-->
		<rwsui_simple_statbar style="rwsui_waterbar, rwsui_toolbelt_vertical_statbar" pos="803,0" text="[rwsui_statcurrent_foodwater_text]" />

	</window>

	<window name="RWSUI_ToolBelt12" anchor="CenterBottom" pos="-451,97" cursor_area="true">
