			<rect controller="HUDStatBar" stat_type="ActiveItem" pos="{# statvisible ? '0,-2' : '0,0'}" >

				<rwsui_collected_item_list collected_item_style="rwsui_collectedItem_detailed_vertical" pos="-52,44" />

			</rect>

		</rect>

		<rwsui_active_item_grid width="50" height="42" active_item_style="rwsui_activeItem_detailed_vertical" pos="-52,44" />

	</window>

</append>

</configs>