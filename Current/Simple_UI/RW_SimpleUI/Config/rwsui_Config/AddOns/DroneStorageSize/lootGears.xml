<configs>

<!--Drone_Storage_Size-->
<conditional>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '10_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,1</set>
	</if>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '20_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,2</set>
	</if>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '30_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,3</set>
	</if>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '40_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,4</set>
	</if>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '50_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,5</set>
	</if>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '60_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,6</set>
	</if>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '70_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,7</set>
	</if>
	<if cond="modsetting('RW_SimpleUI', 'world', 'DroneStorageSize.roboticDrone') == '80_Slots'">
		<set xpath="/lootcontainers/lootcontainer[@name='roboticDrone']/@size">10,8</set>
	</if>
</conditional>

</configs>