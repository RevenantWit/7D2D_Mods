<configs>

<conditional>
	<!--HUD Settings Addon-->
	<if cond="mod_loaded('RWSUI_HUD_Settings')">
		<conditional>
			<!--Vertical StatBars (v2.x.x)-->
			<if cond="mod_version('RWSUI_HUD_Settings') &gt;= version(2,0,0) and mod_version('RWSUI_HUD_Settings') &lt; version(3,0,0)">
				<conditional>
					<!--ToolBelt StatBars (v2.1.x)-->
					<if cond="mod_version('RWSUI_HUD_Settings') &gt;= version(2,1,0)">
						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_simple_statbar[@style='rwsui_foodbar, rwsui_toolbelt_vertical_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_simple_statbar[@style='rwsui_waterbar, rwsui_toolbelt_vertical_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</if>
					<!--Bottom Left StatBars (v2.0.x)-->
					<else>
						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_simple_statbar[@style='rwsui_foodbar, rwsui_vertical_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_simple_statbar[@style='rwsui_waterbar, rwsui_vertical_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</else>
				</conditional>
			</if>
			<!--Round StatBars (v3.x.x)-->
			<if cond="mod_version('RWSUI_HUD_Settings') &gt;= version(3,0,0) and mod_version('RWSUI_HUD_Settings') &lt; version(4,0,0)">
				<conditional>
					<!--ToolBelt StatBars (v3.1.x)-->
					<if cond="mod_version('RWSUI_HUD_Settings') &gt;= version(3,1,0)">
						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_custom_statbar[@style='rwsui_foodbar, rwsui_radial_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_custom_statbar[@style='rwsui_waterbar, rwsui_radial_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</if>
					<!--Bottom Left StatBars (v3.0.x)-->
					<else>
						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_custom_statbar[@style='rwsui_foodbar, rwsui_radial_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_custom_statbar[@style='rwsui_waterbar, rwsui_radial_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</else>
				</conditional>
			</if>
		</conditional>
	</if>
	<!--Gears Settings-->
	<if cond="mod_loaded('Gears')">
		<conditional>
			<!--Vertical StatBars-->
			<if cond="modsetting('RW_SimpleUI', 'global', 'HUD.StatBars.StatBarType') == 'Vertical'">
				<conditional>
					<!--ToolBelt StatBars-->
					<if cond="modsetting('RW_SimpleUI', 'global', 'HUD.StatBars.StatBarLocation') == 'ToolBelt'">
						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_simple_statbar[@style='rwsui_foodbar, rwsui_toolbelt_vertical_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_simple_statbar[@style='rwsui_waterbar, rwsui_toolbelt_vertical_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</if>
					<!--Bottom Left StatBars-->
					<else>
						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_simple_statbar[@style='rwsui_foodbar, rwsui_vertical_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_simple_statbar[@style='rwsui_waterbar, rwsui_vertical_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</else>
				</conditional>
			</if>
			<!--Round StatBars-->
			<if cond="modsetting('RW_SimpleUI', 'global', 'HUD.StatBars.StatBarType') == 'Round'">
				<conditional>
					<!--ToolBelt StatBars-->
					<if cond="modsetting('RW_SimpleUI', 'global', 'HUD.StatBars.StatBarLocation') == 'ToolBelt'">
						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_custom_statbar[@style='rwsui_foodbar, rwsui_radial_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_custom_statbar[@style='rwsui_waterbar, rwsui_radial_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</if>
					<!--Bottom Left StatBars-->
					<else>
						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_custom_statbar[@style='rwsui_foodbar, rwsui_radial_statbar']" name="controller">Quartz.HUDFood, Quartz</setattribute>

						<setattribute xpath ="//window[@name='RWSUI_LeftHUD']//rwsui_custom_statbar[@style='rwsui_waterbar, rwsui_radial_statbar']" name="controller">Quartz.HUDWater, Quartz</setattribute>
					</else>
				</conditional>
			</if>
		</conditional>
	</if>
</conditional>

</configs>
