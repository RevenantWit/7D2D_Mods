<configs>

<conditional>
	<!-- If ToolbeltKeys Remover is v1.1 remove the toolbelt keys background and give toolbelt keys an outline-->
	<if cond="mod_version('RWSUI_ToolBeltKeys_Remover') == version(1,1)">
		<remove xpath="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_toolbelt_keys_bg"/>

		<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_toolbelt_keys" name="textOutline_color">[rwsui_noBG_textOutline_color]</setattribute>
	</if>
	<!-- If ToolbeltKeys Remover is installed and not v1.1 just remove the toolbelt keys background only-->
	<if cond="mod_loaded('RWSUI_ToolBeltKeys_Remover')">
		<remove xpath="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_toolbelt_keys_bg"/>
	</if>
	<if cond="mod_loaded('Gears')">
		<conditional>
			<!-- If ToolbeltKeys are on remove the toolbelt keys background and give toolbelt keys an outline-->
			<if cond="modsetting('RW_SimpleUI', 'global', 'Labels.ToolBelt.ToolBeltKeys') == 'On'">
				<remove xpath="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_toolbelt_keys_bg"/>

				<setattribute xpath ="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_toolbelt_keys" name="textOutline_color">[rwsui_noBG_textOutline_color]</setattribute>
			</if>
			<!-- If ToolbeltKeys are off just remove the toolbelt keys background only-->
			<else>
				<remove xpath="//window[@name='RWSUI_ToolBelt10' or @name='RWSUI_ToolBelt12' or @name='RWSUI_ToolBelt15']//rwsui_toolbelt_keys_bg"/>
			</else>
		</conditional>
	</if>

</conditional>


</configs>
