<configs>

<append xpath="/windows">

	<window name="RWSUI_LeftHUD" anchor="LeftBottom" pos="5,146" >
		<rect name="HUDLeftStatBars" side="right">
			<!--Stealth Bar-->
			<rwsui_custom_statbar_stealth style="rwsui_stealthbar, rwsui_radial_statbar" pos="154,11" />

			<!--Stamina Bar-->
			<rwsui_custom_statbar style="rwsui_staminabar, rwsui_radial_statbar" pos="-1,11" text="[rwsui_statcurrent_stamina_text]" />

			<!--Health Bar-->
			<rwsui_custom_statbar style="rwsui_healthbar, rwsui_radial_statbar" pos="77,11" />

			<!--Food Bar-->
			<rwsui_custom_statbar style="rwsui_foodbar, rwsui_radial_statbar" pos="-1,-68" text="[rwsui_statcurrent_foodwater_text]" />

			<!--Water Bar-->
			<rwsui_custom_statbar style="rwsui_waterbar, rwsui_radial_statbar" pos="77,-68" text="[rwsui_statcurrent_foodwater_text]" />

			<!--XP Bar-->
			<rwsui_custom_statbar_xp style="rwsui_xpbar, rwsui_radial_statbar" pos="154,-68" text="[rwsui_xpbar_level_only_text]" />
		</rect>
	</window>

</append>

</configs>
