<configs>

<append xpath="/windows">

	<window name="RWSUI_RightHUD" anchor="RightBottom">

		<rect controller="HUDStatBar" stat_type="VehicleHealth" pos="{# statvisible ? '0,-20' : '0,0'}" >

			<rect controller="HUDStatBar" stat_type="ActiveItem" pos="{# statvisible ? '0,-4' : '0,0'}" >

				<rwsui_collected_item_list collected_item_style="rwsui_collectedItem_detailed_round" pos="-44,43" />

			</rect>

		</rect>

		<rwsui_active_item_grid width="42" height="42" active_item_style="rwsui_activeItem_detailed_round" pos="-44,43" />

	</window>

</append>

</configs>