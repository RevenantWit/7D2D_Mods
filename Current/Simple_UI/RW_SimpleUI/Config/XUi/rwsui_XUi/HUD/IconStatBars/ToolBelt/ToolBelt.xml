<configs>

<append xpath="/windows">

	<window name="RWSUI_ToolBelt10" anchor="CenterBottom" pos="-376,80" cursor_area="true">
		<rect name="windowToolbelt" width="753" height="78" depth="5" backgroundcolor="[black]" controller="ToolbeltWindow">

			<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" color="[black]" type="sliced" fillcenter="false" on_press="true" gamepad_selectable="false" />
			
			<!--Toolbelt-->
			<rwsui_toolbelt clear_inventory1_pos="765,19" clear_inventory2_pos="765,53" />

		</rect>

		<conditional evaluator="client">
			<if cond="mod_loaded('RW_SimpleUI')">
				<!--Stealth Bar-->
				<rwsui_custom_statbar_stealth style="rwsui_stealthbar, rwsui_custom_iconstatbar_stealth" pos="-175,-15" />

				<!--Stamina Bar-->
				<rwsui_custom_statbar style="rwsui_staminabar, rwsui_custom_iconstatbar_stamina" pos="-120,-15" />

				<!--Health Bar-->
				<rwsui_custom_statbar style="rwsui_healthbar, rwsui_custom_iconstatbar_health" pos="-60,-15" />

				<!--Food Bar-->
				<rwsui_custom_statbar style="rwsui_foodbar, rwsui_custom_iconstatbar_food" pos="753,-17" />

				<!--Water Bar-->
				<rwsui_custom_statbar style="rwsui_waterbar, rwsui_custom_iconstatbar_water" pos="813,-17" />

				<!--XP Bar-->
				<rwsui_custom_statbar_xp style="rwsui_xpbar, rwsui_custom_iconstatbar_xp" pos="868,-17" />
			</if>
			<else>
				<!--Stealth Bar-->
				<rwsui_custom_statbar_stealth style="rwsui_stealthbar, rwsui_simple_iconstatbar_stealth" pos="-175,-15" />

				<!--Stamina Bar-->
