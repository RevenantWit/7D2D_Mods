<configs>
<!--CONTENTS START-->
<!---->
<!--_Player_BackPack_Size_Addon-->
<!--_Drone_Storage_Size_Addon-->
<!--_Vehicle_Storage_Size_Addon-->
<!---->
<!--CONTENTS END-->

<!--_Player_BackPack_Size_Addon START-->
<conditional>
	<if cond="mod_loaded('RWSUI_BackPack_Size')">
		<include filename="rwsui_Config/AddOns/BigBag/loot.xml" />
	</if>
	<if cond="mod_loaded('Gears')">
		<conditional>
			<if cond="modsetting('RW_SimpleUI', 'world', 'PlayerBackPack.BackPackSize') != 'Vanilla'">
				<include filename="rwsui_Config/AddOns/BigBag/loot.xml" />
			</if>
		</conditional>
	</if>
</conditional>
<!--_Player_BackPack_Size_Addon END-->

<!--_Drone_Storage_Size_Addon START-->
<conditional>
	<if cond="mod_loaded('RWSUI_DroneStorageSize')">
		<include filename="rwsui_Config/AddOns/DroneStorageSize/loot.xml" />
	</if>
	<if cond="mod_loaded('Gears')">
		<include filename="rwsui_Config/AddOns/DroneStorageSize/lootGears.xml" />
	</if>
</conditional>
<!--_Drone_Storage_Size_Addon END-->

<!--_Vehicle_Storage_Size_Addon START-->
<conditional>
	<if cond="mod_loaded('RWSUI_4x4TruckStorage') or mod_loaded('RWSUI_BicycleStorage') or mod_loaded('RWSUI_GyrocopterStorage') or mod_loaded('RWSUI_MinibikeStorage') or mod_loaded('RWSUI_MotorcycleStorage')">
		<include filename="rwsui_Config/AddOns/VehicleStorageSize/loot.xml" />
	</if>
	<if cond="mod_loaded('Gears')">
		<include filename="rwsui_Config/AddOns/VehicleStorageSize/lootGears.xml" />
	</if>
</conditional>
<!--_Vehicle_Storage_Size_Addon END-->

</configs>