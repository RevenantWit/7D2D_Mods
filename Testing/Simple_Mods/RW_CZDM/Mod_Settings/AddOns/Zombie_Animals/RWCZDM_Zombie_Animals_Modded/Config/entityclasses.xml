<config>
<!--Check to make sure RW_CZDM mod is installed-->
<conditional>
	<if cond="mod_loaded('RW_CZDM')">

<!--All values used below are a percentage add-->
<!--This means 0.10 = 10% and 1.00 = 100%  /  so for example 2.50 would be 250% -->
<!--A positive or negative value can be used so for instance body damage set to -1.00 is equal to -100% body damage-->
<!--A zero can be used if not wanting to affect damage-->

<!--_ZOMBIE_ANIMALS_MOD_ADDED_GROUP START-->
<append xpath="//entity_class[@name='playerMale']">
	<!--Body Damage-->
	<effect_group name="rwBodyDamageModifier">
		<requirement name="IsAlive" target="other"/>
		<requirement name="!HitLocation" body_parts="Head"/>
		<requirement name="EntityTagCompare" target="other" tags="rwZombieAnimalsMod"/>
		<passive_effect name="DamageModifier" operation="perc_add" value="-0.80"/><!--Body Damage Multiplier-->
	</effect_group>

	<!--Head Damage-->
	<effect_group name="rwHeadDamageModifier">
		<requirement name="IsAlive" target="other"/>
		<requirement name="HitLocation" body_parts="Head"/>
		<requirement name="EntityTagCompare" target="other" tags="rwZombieAnimalsMod"/>
		<passive_effect name="DamageModifier" operation="perc_add" value="0.00"/><!--Head Damage Multiplier-->
	</effect_group>
</append>
<!--_ZOMBIE_ANIMALS_MOD_ADDED_GROUP START-->

<!--_Gears_Settings START-->
<!--Gears settings will only apply if gears is installed and the settings have been changed in the main RW_CZDM mod.-->
<!--Gears settings will overwrite the settings set in _ZOMBIE_ANIMALS_MOD_ADDED_GROUP above if used.-->
<conditional>
	<if cond="mod_loaded('Gears')">
	<!--Body Damage-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'ZombieAnimal.Modded.BodyDamage') != '-0.80'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwBodyDamageModifier' and ./requirement[@tags='rwZombieAnimalsMod']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'ZombieAnimal.Modded.BodyDamage')</set>
			</if>
		</conditional>
	<!--Head Damage-->
		<conditional>
			<if cond="modsetting('RW_CZDM', 'Global', 'ZombieAnimal.Modded.HeadDamage') != '0.00'">
				<set xpath="//entity_class[@name='playerMale']/effect_group[@name='rwHeadDamageModifier' and ./requirement[@tags='rwZombieAnimalsMod']]/passive_effect/@value">modsetting('RW_CZDM', 'Global', 'ZombieAnimal.Modded.HeadDamage')</set>
			</if>
		</conditional>
			</if>
		</conditional>
<!--_Gears_Setting END-->

<!--WARNING: the following sets the tag used for this zombie group, messing with this can break this addons function, edit or add to it at your own risk-->
<!--_ZOMBIE_ANIMALS_MOD_ADDED_GROUP_TAG START-->
<csv xpath="//entity_class/property[@name='Tags'][
	contains(@value, 'animal') and
	contains(@value, 'zombie') and
	not(contains(@value, 'rwZombieDogs')) and
	not(contains(@value, 'rwZombieBears')) and
	not(contains(@value, 'rwRegZombieVultures')) and
	not(contains(@value, 'rwRadZombieVultures')) and
	not(contains(@value, 'rwDireWolf')) and
	not(contains(@value, 'rwBoarBossGrace')) and
	not(contains(@value, 'boss'))
]/@value" delim="," op="add" >rwZombieAnimalsMod</csv>
<!--_ZOMBIE_ANIMALS_MOD_ADDED_GROUP_TAG END-->
	</if>
</conditional>

</config>
