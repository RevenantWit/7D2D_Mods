<!--_PERK_BOOKS START-->
<conditional>
	<!--Add perk book related material if RWBB_PerkBook_Blocker is not installed-->
	<!--This is first so that it can override gears setting-->
	<if cond="mod_loaded('RWBB_PerkBook_Blocker') == 'false'">

		<!--Check to see if Gears is installed before checking against Gears settings-->
		<conditional>
			<if cond="mod_loaded('Gears')">

				<!--Add perk book related material if gears world setting for perk book blocker is not On-->
				<conditional>
					<if cond="modsetting('RW_BindingBench', 'world', 'PerkBooks.pbBlocker') != 'On'">
						<include filename="rw_Config/Perk_Books/materials.xml"/>
					</if>
				</conditional>
			</if>
			<!--If RWBB_PerkBook_Blocker and Gears is not installed add the perk book related material (Default Fallback)-->
			<else>
				<include filename="rw_Config/Perk_Books/materials.xml"/>
			</else>
		</conditional>
	</if>
</conditional>
<!--_PERK_BOOKS END-->

