<configs>
<!--CONTENTS START-->
<!---->
<!--_Core_Templates-->
<!---->
<!--_12_Slot_ToolBelt_Patch-->
<!--_15_Slot_ToolBelt_Patch-->
<!--_Wookies_Cruise_Control_Patch-->
<!---->
<!--CONTENTS END-->

<!--_Core_Templates Start-->
<include filename="rwsui_XUi/0_Core/templates.xml"/>
<!--_Core_Templates END-->

<!--_12_Slot_ToolBelt_Patch START-->
<conditional>
	<if cond="mod_loaded('WMM12SlotToolbelt') or mod_loaded('TheMeanOnes12SlotToolbelt') or mod_loaded('Dewtas12SlotToolbelt') and mod_loaded('RWSUI_ToolBelt_Blocker') == 'false'">
		<conditional>
			<if cond="mod_loaded('Gears')">
				<conditional>
					<if cond="modsetting('RW_SimpleUI', 'global', 'Misc.SimpleUIBlockers.ToolBeltBlocker') == 'Off'">
						<include filename="rwsui_XUi/Patches/12SlotToolBelt/templates.xml" />
					</if>
				</conditional>
			</if>
			<else>
				<include filename="rwsui_XUi/Patches/12SlotToolBelt/templates.xml" />
			</else>
		</conditional>
	</if>
</conditional>
<!--_12_Slot_ToolBelt_Patch END-->

<!--_15_Slot_ToolBelt_Patch START-->
<conditional>
	<if cond="mod_loaded('15SlotToolbelt') or mod_loaded('TheMeanOnes15SlotToolbelt') or mod_loaded('Dewtas15SlotToolbelt') and mod_loaded('RWSUI_ToolBelt_Blocker') == 'false'">
		<conditional>
			<if cond="mod_loaded('Gears')">
				<conditional>
					<if cond="modsetting('RW_SimpleUI', 'global', 'Misc.SimpleUIBlockers.ToolBeltBlocker') == 'Off'">
						<set xpath="//rwsui_toolbelt_keys_bg/@cols">15</set>
					</if>
				</conditional>
			</if>
			<else>
				<set xpath="//rwsui_toolbelt_keys_bg/@cols">15</set>
			</else>
		</conditional>
	</if>
</conditional>
<!--_15_Slot_ToolBelt_Patch END-->

<!--_Wookies_Cruise_Control_Patch START-->
<conditional>
	<if cond="mod_loaded('WMMVehicleCruiseControl')">
		<include filename="rwsui_XUi/Patches/WookiesVCC/templates.xml" />
	</if>
</conditional>
<!--_Wookies_Cruise_Control_Patch END-->

</configs>
