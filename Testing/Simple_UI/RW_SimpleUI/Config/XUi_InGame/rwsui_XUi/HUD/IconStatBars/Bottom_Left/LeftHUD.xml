<configs>

<append xpath="/windows">

	<window name="RWSUI_LeftHUD" anchor="LeftBottom" pos="-10,63" >
		<rect name="HUDLeftStatBars" side="right">
			<conditional evaluator="client">
				<if cond="mod_loaded('RW_SimpleUI')">
					<!--Stealth Bar-->
					<rwsui_custom_statbar_stealth style="rwsui_stealthbar, rwsui_custom_iconstatbar_stealth" pos="325,0" />

					<!--Stamina Bar-->
					<rwsui_custom_statbar style="rwsui_staminabar, rwsui_custom_iconstatbar_stamina" pos="0,0" />

					<!--Health Bar-->
					<rwsui_custom_statbar style="rwsui_healthbar, rwsui_custom_iconstatbar_health" pos="58,0" />

					<!--Food Bar-->
					<rwsui_custom_statbar style="rwsui_foodbar, rwsui_custom_iconstatbar_food" pos="130,0" />

					<!--Water Bar-->
					<rwsui_custom_statbar style="rwsui_waterbar, rwsui_custom_iconstatbar_water" pos="195,0" />

					<!--XP Bar-->
					<rwsui_custom_statbar_xp style="rwsui_xpbar, rwsui_custom_iconstatbar_xp" pos="255,0" />
				</if>
				<else>
					<!--Stealth Bar-->
					<rwsui_custom_statbar_stealth style="rwsui_stealthbar, rwsui_simple_iconstatbar_stealth" pos="325,0" />

					<!--Stamina Bar-->
					<rwsui_custom_statbar style="rwsui_staminabar, rwsui_simple_iconstatbar_stamina" pos="0,0" />

					<!--Health Bar-->
					<rwsui_custom_statbar style="rwsui_healthbar, rwsui_simple_iconstatbar_health" pos="58,0" />

					<!--Food Bar-->
					<rwsui_custom_statbar style="rwsui_foodbar, rwsui_simple_iconstatbar_food" pos="130,0" />

					<!--Water Bar-->
					<rwsui_custom_statbar style="rwsui_waterbar, rwsui_simple_iconstatbar_water" pos="195,0" />

					<!--XP Bar-->
					<rwsui_custom_statbar_xp style="rwsui_xpbar, rwsui_simple_iconstatbar_xp" pos="255,0" />
				</else>
			</conditional>
		</rect>

	</window>

</append>

</configs>
