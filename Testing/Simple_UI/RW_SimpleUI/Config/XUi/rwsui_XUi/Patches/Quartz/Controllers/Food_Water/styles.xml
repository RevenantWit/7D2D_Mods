<configs>

<append xpath="/styles/global">

	<style_entry name="rwsui_foodbar_quartz_controller" value="Quartz.HUDFood, Quartz"/>

	<style_entry name="rwsui_waterbar_quartz_controller" value="Quartz.HUDWater, Quartz"/>

</append>

<set xpath="//global/style_entry[@name='rwsui_statcurrent_foodwater_text']/@value">{# statcurrent &lt; (statmax-1) ? statcurrent : statmax}</set>

<conditional>
	<!--Patch if running less than game v2.5-->
	<if cond="game_version() &lt; version(1,2,5)">
		<set xpath="//style[@name='rwsui_foodbar']/style_entry[@name='controller']/@value">Quartz.HUDFood, Quartz</set>

		<set xpath="//style[@name='rwsui_waterbar']/style_entry[@name='controller']/@value">Quartz.HUDWater, Quartz</set>

		<set xpath="//style[@name='rwsui_foodbar' or @name='rwsui_waterbar']/style_entry[@name='text']/@value">{# statcurrent &lt; (statmax-1) ? statcurrent : statmax}/{statmax}</set>
	</if>
</conditional>

</configs>
