				<rwsui_collected_item_list collected_item_style="rwsui_collectedItem_detailed_horizontal" pos="-49,49" />

			</rect>

		</rect>

		<rwsui_active_item_grid width="46" active_item_style="rwsui_activeItem_detailed_horizontal" pos="-49,49" />

	</window>

</append>

</configs>