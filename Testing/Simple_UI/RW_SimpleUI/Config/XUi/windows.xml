<!--_HUD_Settings START-->
<conditional>
	<!--HUD Settings Addon-->
	<if cond="mod_loaded('RWSUI_HUD_Settings')">
		<!-- First number is hud layout type-->
		<!-- (2 = Vertical), (3 = Round), (4 = MiniHUD), (5 = Icon_StatBars), (Else/1 = Horizontal)-->

		<!-- Second number is hud layout location-->
		<!-- (1 = ToolBelt), (Else/0 = Bottom_left)-->

		<!-- Third number is buff panel type-->
		<!-- (1 = Vanilla), (2 = Detailed), (Else/0 = Simple)-->
		<conditional>
			<!--Vertical StatBars (v2.x.x)-->
			<if cond="mod_version('RWSUI_HUD_Settings') &gt;= version(2,0,0) and mod_version('RWSUI_HUD_Settings') &lt; version(3,0,0)">
				<conditional>
					<!--ToolBelt StatBars (v2.1.x)-->
					<if cond="mod_version('RWSUI_HUD_Settings') &gt;= version(2,1,0)">
						<include filename="rwsui_XUi/HUD/0_Common/NoStats/LeftHUD.xml" />
						<conditional>
							<if cond="mod_version('RWSUI_HUD_Settings') == version(2,1,1)">
								<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/VanillaBuffs/BuffPanel.xml" />
								<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/VanillaBuffs/RightHUD.xml" />
							</if>
							<if cond="mod_version('RWSUI_HUD_Settings') == version(2,1,2)">
								<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/DetailedBuffs/BuffPanel.xml" />
								<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/DetailedBuffs/RightHUD.xml" />
							</if>
							<else>
								<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/SimpleBuffs/BuffPanel.xml" />
								<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/SimpleBuffs/RightHUD.xml" />
							</else>
						</conditional>
						<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/VehicleStatBars.xml" />
						<include filename="rwsui_XUi/HUD/Vertical/ToolBelt/ToolBelt.xml" />
						<include filename="rwsui_XUi/HUD/0_Common/ToolBelt_Keys/Square_Background/ToolBelt_Keys.xml" />
					</if>
					<!--Bottom Left StatBars (v2.0.x)-->
