<!--_Player_BackPack_Size_AddOn START-->
<conditional>
	<!--BackPack_Size AddOn-->
	<if cond="mod_loaded('RWSUI_BackPack_Size')">
	
		<!--Replace vanilla backpack grid with a tabbed backpack grid-->
		<include filename="rwsui_XUi/AddOns/BigBag/backpack.xml" />

		<!--Patch if running less than game v2.0-->
		<conditional>
			<if cond="game_version() &lt; version(1,2,0)">
				<include filename="rwsui_XUi/Patches/SimpleUI/Game_v2_0/AddOns/BigBag/windows.xml" />
			</if>
		</conditional>

		<!--Patch oversized loot window on death bag to be scrollable if Quartz is installed-->
		<conditional>
			<if cond="mod_loaded('Quartz')">
				<include filename="rwsui_XUi/Patches/Quartz/Scrollable/windowLooting/windows.xml" />
			</if>
		</conditional>

		<!--Adjust backpack tabs to number of pages selected if not using the biggest setting-->
		<include filename="rwsui_XUi/AddOns/BigBag/backpack_size.xml" />

		<!--Patch to make backpack tab buttons thinner when using 5 or 6 page backpack with Beyond Storage 2-->
		<conditional>
			<if cond="mod_loaded('BeyondStorage2')">
				<include filename="rwsui_XUi/Patches/BeyondStorage2/windows.xml" />
			</if>
		</conditional>
	</if>
	<!--Gears Settings-->
	<if cond="mod_loaded('Gears')">
		<conditional>
			<if cond="modsetting('RW_SimpleUI', 'world', 'PlayerBackPack.BackPackSize') != 'Vanilla'">

				<!--Replace vanilla backpack grid with a tabbed backpack grid-->
				<include filename="rwsui_XUi/AddOns/BigBag/backpack.xml" />

				<!--Patch if running less than game v2.0-->
				<conditional>
					<if cond="game_version() &lt; version(1,2,0)">
						<include filename="rwsui_XUi/Patches/SimpleUI/Game_v2_0/AddOns/BigBag/windows.xml" />
					</if>
				</conditional>

				<!--Patch oversized loot window on death bag to be scrollable if Quartz is installed-->
				<!--This conditional check should not be needed if gears is installed but better safe than sorry-->
				<conditional>
					<if cond="mod_loaded('Quartz')">
						<include filename="rwsui_XUi/Patches/Quartz/Scrollable/windowLooting/windows.xml" />
					</if>
				</conditional>

				<!--Adjust backpack tabs to number of pages selected if not using the biggest setting-->
				<include filename="rwsui_XUi/AddOns/BigBag/backpack_size.xml" />

				<!--Patch to make backpack tab buttons thinner when using 5 or 6 page backpack with Beyond Storage 2-->
				<conditional>
					<if cond="mod_loaded('BeyondStorage2')">
						<include filename="rwsui_XUi/Patches/BeyondStorage2/windows.xml" />
					</if>
				</conditional>
			</if>
		</conditional>
	</if>
</conditional>
<!--_Player_BackPack_Size_AddOn END-->

